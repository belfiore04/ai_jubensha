# LLM 配置 (OpenAI 兼容模式，可对接 MiniMax / DeepSeek / OpenRouter 等)
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=m2.7
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# 讨论引擎 — 角色对话 (DeepSeek, 效果更好)
DISC_CHAT_API_KEY=your-dashscope-api-key
DISC_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DISC_CHAT_MODEL=deepseek-v3.2

# 讨论引擎 — 选人路由 (qwen-turbo, 更快更便宜)
DISC_SELECTOR_API_KEY=your-dashscope-api-key
DISC_SELECTOR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DISC_SELECTOR_MODEL=qwen-turbo

# Langfuse 配置 (可观测性追踪)
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_HOST=http://localhost:3200
